# Copy this file to .env and fill in your values
PORT=3000
OWM_KEY=your_openweathermap_api_key
LAT=25.033
LON=121.5654
CAL_URL=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/basic.ics
# calendar2 uses the Google Calendar API via OAuth (not ICS, not an API key) so it can
# filter by event color and read a calendar you're only a guest on. Obtain these via a
# one-time OAuth device-code authorization (see setup notes).
CAL2_ID=YOUR_SECOND_CALENDAR_ID@group.calendar.google.com
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
